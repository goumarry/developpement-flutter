# --- Firebase ---------------------------------------------------------------
# lib/data/firebase/firebase_options.dart et android/app/google-services.json
# SONT versionnés : identifiants publics de projet, pas des secrets (voir
# README, « Configuration Firebase »). Journaux, caches de la CLI et clés de
# compte de service ne le sont jamais.
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/
*-adminsdk-*.json
serviceAccount*.json

# Signature de publication (README, « Étapes restantes ») : jamais versionnée.
android/key.properties
*.jks
*.keystore
